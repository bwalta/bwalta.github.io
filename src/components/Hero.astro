---
interface Props { t: any; }
const { t } = Astro.props;
---
<section class="relative pt-36 md:pt-48 pb-24 md:pb-32 overflow-hidden">
  <div class="blob"></div>
  <div class="mx-auto max-w-page px-6 md:px-10">
    <p class="text-xs uppercase tracking-[0.2em] text-muted mb-6" data-hero-word>{t.hero.kicker}</p>

    <h1 class="font-display font-semibold tracking-tightest text-5xl md:text-7xl lg:text-[5.5rem] leading-[0.98] max-w-5xl">
      <span class="block" data-hero-word>{t.hero.title_a}</span>
      <span class="block bg-gradient-to-r from-accent via-violet-500 to-pink-500 bg-clip-text text-transparent" data-hero-word>{t.hero.title_b}</span>
      <span class="block text-ink/80" data-hero-word>{t.hero.title_c}</span>
    </h1>

    <p class="mt-8 max-w-xl text-base md:text-lg text-ink/60" data-hero-word>{t.hero.sub}</p>

    <div class="mt-10 flex flex-wrap items-center gap-3" data-hero-word>
      <a href="#work" class="rounded-full bg-ink text-canvas px-5 py-2.5 text-sm font-medium hover:bg-accent transition-colors">
        {t.hero.cta_work} →
      </a>
      <a href="https://github.com/bwalta" target="_blank" rel="noreferrer" class="rounded-full border border-line bg-surface px-5 py-2.5 text-sm font-medium hover:border-ink/40 transition-colors">
        {t.hero.cta_github}
      </a>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden md:flex flex-col items-center gap-2 text-muted text-xs">
    <span>scroll</span>
    <div class="h-10 w-px bg-line relative overflow-hidden">
      <span class="absolute inset-x-0 top-0 h-3 bg-ink/40 animate-[drop_2s_ease-in-out_infinite]"></span>
    </div>
  </div>
</section>

<style>
  @keyframes drop {
    0%, 100% { transform: translateY(-100%); }
    50% { transform: translateY(280%); }
  }
</style>
