---
interface Props { t: any; }
const { t } = Astro.props;

const stack = [
  { name: 'TypeScript', emoji: '📘' },
  { name: 'Python', emoji: '🐍' },
  { name: 'React', emoji: '⚛️' },
  { name: 'Next.js', emoji: '▲' },
  { name: 'Astro', emoji: '🚀' },
  { name: 'Node.js', emoji: '🟢' },
  { name: 'Supabase', emoji: '🟩' },
  { name: 'OpenAI / Claude', emoji: '🤖' },
  { name: 'Playwright', emoji: '🎭' },
  { name: 'Tailwind CSS', emoji: '🎨' },
];
---
<section id="stack" class="py-24 md:py-36 border-t border-line/60">
  <div class="mx-auto max-w-page px-6 md:px-10 grid md:grid-cols-12 gap-10 md:gap-16">
    <div class="md:col-span-3 reveal">
      <p class="text-xs uppercase tracking-[0.2em] text-muted">{t.stack.label}</p>
    </div>
    <div class="md:col-span-9 reveal">
      <h2 class="font-display font-semibold tracking-tightest text-3xl md:text-5xl leading-[1.05] max-w-3xl">
        {t.stack.title}
      </h2>
      <p class="mt-6 max-w-xl text-lg text-ink/65">{t.stack.intro}</p>

      <ul class="mt-12 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {stack.map((s) => (
          <li class="group flex items-center gap-3 rounded-2xl border border-line bg-surface px-4 py-3 hover:border-ink/30 transition-colors">
            <span class="text-lg" aria-hidden="true">{s.emoji}</span>
            <span class="text-sm font-medium tracking-tight">{s.name}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
