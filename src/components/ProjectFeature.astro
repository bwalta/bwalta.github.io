---
interface Props {
  index: number;
  kicker: string;
  title: string;
  desc: string;
  tags: string[];
  images: string[];
  ctaLabel?: string;
  ctaHref?: string;
  variant?: 'phone' | 'browser';
  reverse?: boolean;
}
const { index, kicker, title, desc, tags, images, ctaLabel, ctaHref, variant = 'phone', reverse = false } = Astro.props;
const numStr = String(index).padStart(2, '0');
---
<article class={`relative py-20 md:py-32 ${reverse ? 'bg-soft/40' : ''}`}>
  <div class="mx-auto max-w-page px-6 md:px-10">
    <div class={`grid md:grid-cols-12 gap-10 md:gap-16 items-center ${reverse ? 'md:[&>*:first-child]:order-2' : ''}`}>

      <div class="md:col-span-6 reveal">
        <div class="flex items-center gap-3 text-xs uppercase tracking-[0.2em] text-muted mb-4">
          <span class="font-mono">{numStr}</span>
          <span class="h-px w-8 bg-line"></span>
          <span>{kicker}</span>
        </div>
        <h3 class="font-display font-semibold tracking-tightest text-4xl md:text-5xl leading-[1.05]">
          {title}
        </h3>
        <p class="mt-5 max-w-md text-lg text-ink/70 leading-relaxed">{desc}</p>

        <div class="mt-7 flex flex-wrap gap-2">
          {tags.map((tag) => <span class="chip">{tag}</span>)}
        </div>

        {ctaLabel && ctaHref && (
          <a href={ctaHref} target="_blank" rel="noreferrer" class="mt-8 inline-flex items-center gap-2 rounded-full bg-ink text-canvas px-5 py-2.5 text-sm font-medium hover:bg-accent transition-colors">
            {ctaLabel} →
          </a>
        )}
      </div>

      <div class="md:col-span-6 reveal">
        <div class={variant === 'phone' ? 'relative grid grid-cols-3 gap-3 md:gap-5' : 'relative'}>
          {variant === 'phone' ? (
            images.slice(0, 3).map((src, i) => (
              <div
                class={`phone tilt ${i === 1 ? 'translate-y-6' : ''}`}
                data-parallax
                style={`--delay:${i * 0.1}s`}
              >
                <img src={src} alt={`${title} screen ${i + 1}`} loading="lazy" decoding="async" class="w-full h-auto block" />
              </div>
            ))
          ) : (
            <div class="browser tilt" data-parallax>
              <div class="flex items-center gap-1.5 px-4 py-2.5 bg-surface border-b border-line">
                <span class="h-2.5 w-2.5 rounded-full bg-[#FF5F57]"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[#FEBC2E]"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[#28C840]"></span>
                <span class="ml-3 text-xs text-muted">aeopilot.io</span>
              </div>
              <img src={images[0]} alt={`${title} screen`} loading="lazy" decoding="async" class="w-full h-auto block" />
              {images[1] && (
                <div class="hidden md:block absolute -bottom-10 -right-6 w-2/3 browser tilt" style="z-index:-1; opacity:0.95;">
                  <img src={images[1]} alt={`${title} screen 2`} loading="lazy" decoding="async" class="w-full h-auto block" />
                </div>
              )}
            </div>
          )}
        </div>
      </div>

    </div>
  </div>
</article>
