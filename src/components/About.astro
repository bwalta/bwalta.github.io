---
interface Props { t: any; }
const { t } = Astro.props;
---
<section id="about" class="py-24 md:py-36 border-t border-line/60">
  <div class="mx-auto max-w-page px-6 md:px-10 grid md:grid-cols-12 gap-10 md:gap-16">
    <div class="md:col-span-3 reveal">
      <p class="text-xs uppercase tracking-[0.2em] text-muted">{t.about.label}</p>
    </div>
    <div class="md:col-span-9 reveal">
      <p class="font-display font-semibold tracking-tight text-xl md:text-2xl text-ink mb-4">{t.about.name}</p>
      <h2 class="font-display font-semibold tracking-tightest text-3xl md:text-5xl leading-[1.05] max-w-3xl">
        {t.about.title}
      </h2>
      <div class="mt-8 max-w-2xl space-y-4 text-lg text-ink/70 leading-relaxed">
        <p>{t.about.body_1}</p>
        <p>{t.about.body_2}</p>
      </div>
    </div>
  </div>
</section>
