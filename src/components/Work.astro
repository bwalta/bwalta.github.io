---
import ProjectFeature from './ProjectFeature.astro';
interface Props { t: any; }
const { t } = Astro.props;
---
<section id="work" class="border-t border-line/60">
  <div class="mx-auto max-w-page px-6 md:px-10 pt-24 md:pt-36 pb-8">
    <div class="grid md:grid-cols-12 gap-10 md:gap-16">
      <div class="md:col-span-3 reveal">
        <p class="text-xs uppercase tracking-[0.2em] text-muted">{t.work.label}</p>
      </div>
      <div class="md:col-span-9 reveal">
        <h2 class="font-display font-semibold tracking-tightest text-3xl md:text-5xl leading-[1.05] max-w-3xl">
          {t.work.intro}
        </h2>
      </div>
    </div>
  </div>

  <ProjectFeature
    index={1}
    kicker={t.projects.companionry.kicker}
    title={t.projects.companionry.title}
    desc={t.projects.companionry.desc}
    tags={[]}
    images={["/projects/companionry/home.png", "/projects/companionry/dashboard.png", "/projects/companionry/chat.png"]}
    ctaLabel={t.projects.companionry.cta}
    ctaHref="https://apps.apple.com/search?term=Companionry"
    variant="phone"
  />

  <ProjectFeature
    index={2}
    kicker={t.projects.aeopilot.kicker}
    title={t.projects.aeopilot.title}
    desc={t.projects.aeopilot.desc}
    tags={[]}
    images={["/projects/aeopilot/landing.png", "/projects/aeopilot/score.png"]}
    variant="browser"
    reverse
  />
</section>
