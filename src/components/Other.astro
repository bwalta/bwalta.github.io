---
interface Props { t: any; }
const { t } = Astro.props;
---
<section class="py-24 md:py-32 border-t border-line/60 bg-soft/30">
  <div class="mx-auto max-w-page px-6 md:px-10 grid md:grid-cols-12 gap-10 md:gap-16">
    <div class="md:col-span-3 reveal">
      <p class="text-xs uppercase tracking-[0.2em] text-muted">{t.other.label}</p>
    </div>
    <div class="md:col-span-9 reveal">
      <h2 class="font-display font-semibold tracking-tightest text-3xl md:text-4xl leading-[1.1] mb-10">
        {t.other.title}
      </h2>

      <div class="grid sm:grid-cols-2 gap-5 md:gap-6 max-w-3xl">
        <article class="group rounded-3xl border border-line bg-surface p-6 md:p-8 tilt">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="font-display font-semibold text-xl md:text-2xl tracking-tight">{t.other.wa_title}</h3>
              <p class="mt-2 text-ink/65 leading-relaxed">{t.other.wa_desc}</p>
            </div>
            <span class="shrink-0 h-12 w-12 rounded-2xl bg-gradient-to-br from-emerald-100 to-emerald-50 grid place-items-center text-2xl">💬</span>
          </div>
        </article>

        <article class="group rounded-3xl border border-line bg-surface p-6 md:p-8 tilt">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="font-display font-semibold text-xl md:text-2xl tracking-tight">{t.other.pw_title}</h3>
              <p class="mt-2 text-ink/65 leading-relaxed">{t.other.pw_desc}</p>
            </div>
            <span class="shrink-0 h-12 w-12 rounded-2xl bg-gradient-to-br from-violet-100 to-violet-50 grid place-items-center text-2xl">🎭</span>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
